{
  "name": "@commercelayer/drop-in.js",
  "version": "2.26.2",
  "description": "Transform any plain HTML page into an enterprise-grade static commerce website, with almost no coding required.",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "es2015": "dist/esm/index.mjs",
  "es2017": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/drop-in/drop-in.esm.js",
  "files": [
    "dist/"
  ],
  "homepage": "https://commercelayer.github.io/drop-in.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/commercelayer/drop-in.js.git"
  },
  "keywords": [
    "ecommerce",
    "custom-elements",
    "mfe",
    "micro-frontend",
    "composable-commerce",
    "drop-in"
  ],
  "scripts": {
    "prepare": "pnpm build",
    "build": "stencil build --docs && pnpm build:sass",
    "build:sass": "sass --style compressed ./src/styles/:./dist/drop-in/",
    "build:watch": "stencil build --docs --watch",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil-test",
    "test:unit": "stencil-test --project spec",
    "test:watch": "stencil-test --watch",
    "test:unit:watch": "stencil-test --watch --project spec",
    "test:e2e": "stencil-test --project e2e",
    "test:e2e:watch": "stencil-test --watch --project e2e",
    "generate": "stencil generate",
    "ts:check": "tsc --noEmit"
  },
  "author": {
    "name": "Marco Montalbano",
    "email": "marco.montalbano@commercelayer.io"
  },
  "dependencies": {
    "@commercelayer/js-auth": "^7.4.2",
    "@commercelayer/organization-config": "^2.8.4",
    "@commercelayer/sdk": "^7.12.0",
    "@types/lodash": "^4.17.24",
    "@types/lodash-es": "^4.17.12",
    "iframe-resizer": "4.3.11",
    "js-cookie": "^3.0.8",
    "lodash-es": "^4.18.1",
    "type-fest": "^5.8.0"
  },
  "peerDependencies": {
    "@stencil/core": "^4.0.0"
  },
  "devDependencies": {
    "@stencil/core": "^4.43.5",
    "@stencil/sass": "3.2.3",
    "@stencil/vitest": "^1.14.0",
    "@types/iframe-resizer": "^4.0.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^22.20.1",
    "@vitest/browser-playwright": "^4.1.10",
    "lodash": "^4.18.1",
    "sass": "^1.101.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18",
    "pnpm": "10.4.0"
  }
}
